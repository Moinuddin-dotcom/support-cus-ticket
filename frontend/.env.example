# Base URL of the NestJS API, including the /api prefix.
# Only read on the server (Next.js route handlers / server components) — the browser
# never talks to the API directly, it goes through the /api/proxy BFF route.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Optional runtime override (takes precedence; used by docker-compose).
# API_URL=http://backend:4000/api
