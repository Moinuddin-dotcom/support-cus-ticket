# --- Server ---
NODE_ENV=development
PORT=4000
# Origin allowed by CORS (the Next.js frontend)
FRONTEND_URL=http://localhost:3000
# Number of reverse-proxy hops to trust for client IPs (Render = 1)
TRUST_PROXY=1

# --- Database / Redis ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/support_tickets?schema=public
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Use a long random string in production (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# --- Background jobs ---
# How often the SLA overdue sweep runs (ms)
SLA_CHECK_INTERVAL_MS=300000
# Set to "false" to skip BullMQ workers (e.g. when running without Redis)
QUEUE_ENABLED=true

# --- AI suggestions ---
# anthropic | openai | none   (none = always return the safe default)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_MS=15000
